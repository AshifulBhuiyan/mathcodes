---
import Layout from 'layouts/Layout.astro';
import puzzle from '../data/dailyChallenge';

const initialOrder = puzzle.initialOrder;
const codeBlocks = puzzle.codeBlocks;
---

<Layout title="Daily Code-Arrange Challenge — MathCodes" description="Drag and arrange Python blocks to solve a zero-backend math puzzle.">
  <main class="min-h-screen bg-[#111827] text-white">
    <section class="max-w-5xl mx-auto px-6 py-14">
      <p class="text-sm uppercase tracking-[0.2em] text-[#8ecae6] mb-4">Daily hook · zero backend</p>
      <h1 class="text-4xl md:text-5xl font-extrabold text-[#a5d8ff] mb-4">Daily Code-Arrange Challenge</h1>
      <p class="text-lg text-gray-300 max-w-3xl mb-6">
        Drag and arrange shuffled Python blocks to rebuild a human-authored solution. Nothing runs on the server—
        the expected output is pre-baked to keep things fast, safe, and fun.
      </p>
      <div class="flex flex-wrap gap-3 text-sm text-gray-300">
        <span class="bg-[#1f2937] border border-[#2c3a4f] rounded-full px-3 py-1">{puzzle.date}</span>
        <span class="bg-[#1f2937] border border-[#2c3a4f] rounded-full px-3 py-1">Topic: {puzzle.topic}</span>
        <span class="bg-[#1f2937] border border-[#2c3a4f] rounded-full px-3 py-1">Type: {puzzle.type}</span>
        <span class="bg-[#1f2937] border border-[#2c3a4f] rounded-full px-3 py-1">Difficulty: {puzzle.difficulty}</span>
        <span class="bg-[#1f2937] border border-[#2c3a4f] rounded-full px-3 py-1">Puzzle ID: {puzzle.id}</span>
      </div>
    </section>

    <section class="bg-[#0b1020] border-y border-[#1f2937]">
      <div class="max-w-5xl mx-auto px-6 py-10 grid grid-cols-1 md:grid-cols-5 gap-8 items-start">
        <div class="md:col-span-3 bg-[#0f172a] border border-[#1e293b] rounded-2xl p-6 shadow-lg shadow-black/30">
          <div class="flex items-start justify-between gap-3 mb-4">
            <div>
              <p class="text-xs uppercase tracking-[0.2em] text-[#8ecae6] mb-1">Problem</p>
              <h2 class="text-2xl font-semibold text-white">{puzzle.problem}</h2>
              <p class="text-sm text-gray-300 mt-2">{puzzle.description}</p>
            </div>
            <div class="text-right">
              <p class="text-xs text-gray-400">Timer</p>
              <p id="timer" class="text-3xl font-mono text-[#a5d8ff]">00:00</p>
              <p class="text-xs text-gray-500">Starts on first drag</p>
            </div>
          </div>

          <div class="rounded-xl border border-[#243149] bg-[#111827] p-4">
            <div class="flex items-center justify-between mb-3">
              <div>
                <p class="text-sm text-gray-300">Arrange the blocks in the correct order.</p>
                <p class="text-xs text-gray-500">This is client-only: no sandbox or backend calls required.</p>
              </div>
              <div class="flex gap-2 text-sm">
                <button id="reset" class="px-3 py-2 bg-[#1f2937] border border-[#2c3a4f] rounded-lg hover:bg-[#243149]">Reset</button>
                <button id="check" class="px-3 py-2 bg-[#2563eb] text-white rounded-lg hover:bg-[#1d4ed8]">Check order</button>
              </div>
            </div>

            <ul id="code-list" class="space-y-3">
              {initialOrder.map((index) => (
                <li class="code-card" data-index={index} draggable="true">
                  <div class="flex items-center gap-3">
                    <span class="handle">⋮⋮</span>
                    <code class="block text-left whitespace-pre text-sm text-[#e0f2fe]">{codeBlocks[index]}</code>
                  </div>
                </li>
              ))}
            </ul>

            <div id="feedback" class="mt-4 text-sm text-gray-300">
              Drag blocks to start the timer, then check your order. No code will actually execute—the output is pre-stored.
            </div>
          </div>

          <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-[#0f172a] border border-[#1e293b] rounded-xl p-4">
              <p class="text-xs uppercase tracking-[0.2em] text-[#8ecae6] mb-2">Hints</p>
              <ul class="list-disc list-inside text-sm text-gray-300 space-y-2">
                {puzzle.hints.map((hint) => (
                  <li>{hint}</li>
                ))}
              </ul>
            </div>
            <div class="bg-[#0f172a] border border-[#1e293b] rounded-xl p-4">
              <p class="text-xs uppercase tracking-[0.2em] text-[#8ecae6] mb-2">Mock Output</p>
              <p class="text-gray-300 text-sm mb-2">When you click "Run", we reveal the stored output for the correct ordering.</p>
              <button id="run" class="w-full px-4 py-2 bg-[#22c55e] text-black font-semibold rounded-lg hover:bg-[#16a34a]">Run (show expected)</button>
              <pre id="output" class="mt-3 bg-[#0b1224] border border-[#1f2937] rounded-lg p-3 text-[#22c55e] text-sm">Output: —</pre>
            </div>
          </div>
        </div>

        <aside class="md:col-span-2 bg-[#0f172a] border border-[#1e293b] rounded-2xl p-6 shadow-lg shadow-black/30">
          <h3 class="text-xl font-semibold text-white mb-2">Why this is different</h3>
          <p class="text-sm text-gray-300 mb-4">
            This flagship feature hooks learners daily without sandboxes or servers. Everything happens in the browser: drag blocks, see feedback, and share your streak.
          </p>
          <ul class="text-sm text-gray-200 space-y-3">
            <li>🧠 Reinforces mathematical reasoning over syntax.</li>
            <li>🔒 Zero backend complexity—static JSON, client rendering only.</li>
            <li>📅 Fresh daily puzzle IDs keep the content rolling.</li>
            <li>📤 Shareable results to drive community virality.</li>
          </ul>

          <div class="mt-6 bg-[#0b1224] border border-[#1f2937] rounded-lg p-4 text-sm text-gray-200">
            <p class="font-semibold text-white mb-1">Progress</p>
            <p>Attempts: <span id="attempts" class="font-mono">0</span></p>
            <p>Best time: <span id="best-time" class="font-mono">—</span></p>
            <p>Last solved: <span id="last-solved" class="font-mono">—</span></p>
            <button id="share" class="mt-3 w-full px-4 py-2 bg-[#1f2937] border border-[#2c3a4f] rounded-lg hover:bg-[#243149]">Share my attempt</button>
            <p id="share-status" class="mt-2 text-xs text-gray-400"></p>
          </div>
        </aside>
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-6 py-12">
      <h3 class="text-2xl font-semibold text-white mb-3">Roadmap for the daily puzzle line</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm text-gray-200">
        <div class="bg-[#0f172a] border border-[#1e293b] rounded-xl p-4">
          <p class="font-semibold text-white mb-1">Phase 1 — MVP</p>
          <p>Hard-coded daily puzzle page with drag/drop, hints, and mock outputs.</p>
        </div>
        <div class="bg-[#0f172a] border border-[#1e293b] rounded-xl p-4">
          <p class="font-semibold text-white mb-1">Phase 2 — Content system</p>
          <p>YAML-defined puzzles with daily rotation powered purely by static generation.</p>
        </div>
        <div class="bg-[#0f172a] border border-[#1e293b] rounded-xl p-4">
          <p class="font-semibold text-white mb-1">Phase 3 — Gamification</p>
          <p>Client-only timers, streaks, and leaderboards using localStorage until accounts arrive.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script type="application/json" id="puzzle-data">{JSON.stringify(puzzle)}</script>
<script>
  const puzzle = JSON.parse(document.getElementById('puzzle-data').textContent);
  const listEl = document.getElementById('code-list');
  const feedbackEl = document.getElementById('feedback');
  const outputEl = document.getElementById('output');
  const timerEl = document.getElementById('timer');
  const attemptsEl = document.getElementById('attempts');
  const bestTimeEl = document.getElementById('best-time');
  const lastSolvedEl = document.getElementById('last-solved');
  const shareStatusEl = document.getElementById('share-status');

  let order = [...puzzle.initialOrder];
  let attempts = 0;
  let startTime = null;
  let timerInterval = null;
  let solved = false;

  const progressKey = `mathcodes-daily-${puzzle.id}`;

  const formatter = (seconds) => {
    const mins = String(Math.floor(seconds / 60)).padStart(2, '0');
    const secs = String(seconds % 60).padStart(2, '0');
    return `${mins}:${secs}`;
  };

  const loadProgress = () => {
    if (typeof localStorage === 'undefined') return;
    const saved = localStorage.getItem(progressKey);
    if (saved) {
      try {
        const data = JSON.parse(saved);
        if (data.bestTime) bestTimeEl.textContent = formatter(data.bestTime);
        if (data.lastSolved) lastSolvedEl.textContent = new Date(data.lastSolved).toLocaleDateString();
      } catch (e) {
        console.warn('Could not parse saved progress', e);
      }
    }
  };

  const saveProgress = (elapsedSeconds) => {
    if (typeof localStorage === 'undefined') return;
    const saved = localStorage.getItem(progressKey);
    let bestTime = elapsedSeconds;
    let lastSolved = new Date().toISOString();
    if (saved) {
      try {
        const data = JSON.parse(saved);
        if (data.bestTime && data.bestTime < bestTime) bestTime = data.bestTime;
      } catch (e) {
        console.warn('Could not parse saved progress', e);
      }
    }
    localStorage.setItem(progressKey, JSON.stringify({ bestTime, lastSolved }));
    bestTimeEl.textContent = formatter(bestTime);
    lastSolvedEl.textContent = new Date(lastSolved).toLocaleDateString();
  };

  const startTimer = () => {
    if (startTime) return;
    startTime = Date.now();
    timerInterval = setInterval(() => {
      const elapsed = Math.floor((Date.now() - startTime) / 1000);
      timerEl.textContent = formatter(elapsed);
    }, 1000);
  };

  const stopTimer = () => {
    if (timerInterval) clearInterval(timerInterval);
    timerInterval = null;
  };

  const renderList = () => {
    listEl.innerHTML = '';
    order.forEach((blockIndex, position) => {
      const li = document.createElement('li');
      li.className = 'code-card';
      li.setAttribute('draggable', 'true');
      li.dataset.position = position;
      li.dataset.blockIndex = blockIndex;
      li.innerHTML = `<div class="flex items-center gap-3"><span class="handle">⋮⋮</span><code class="block text-left whitespace-pre text-sm text-[#e0f2fe]">${puzzle.codeBlocks[blockIndex]}</code></div>`;

      li.addEventListener('dragstart', (e) => {
        startTimer();
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', position);
        li.classList.add('dragging');
      });

      li.addEventListener('dragover', (e) => {
        e.preventDefault();
        li.classList.add('drag-over');
      });

      li.addEventListener('dragleave', () => li.classList.remove('drag-over'));

      li.addEventListener('drop', (e) => {
        e.preventDefault();
        const fromPos = Number(e.dataTransfer.getData('text/plain'));
        const toPos = Number(li.dataset.position);
        const moved = order.splice(fromPos, 1)[0];
        order.splice(toPos, 0, moved);
        renderList();
      });

      li.addEventListener('dragend', () => {
        li.classList.remove('dragging');
        listEl.querySelectorAll('.code-card').forEach((el) => el.classList.remove('drag-over'));
      });

      listEl.appendChild(li);
    });
  };

  const checkOrder = () => {
    attempts += 1;
    attemptsEl.textContent = attempts;
    const isCorrect = order.every((v, i) => v === puzzle.correctOrder[i]);
    if (isCorrect) {
      solved = true;
      const elapsed = startTime ? Math.floor((Date.now() - startTime) / 1000) : 0;
      stopTimer();
      saveProgress(elapsed);
      feedbackEl.textContent = `✅ Correct! You rebuilt the solution in ${formatter(elapsed)}.`;
      feedbackEl.classList.remove('text-gray-300');
      feedbackEl.classList.add('text-[#22c55e]');
    } else {
      feedbackEl.textContent = 'Not quite yet—reorder the blocks until they match the intended solution.';
      feedbackEl.classList.remove('text-[#22c55e]');
      feedbackEl.classList.add('text-gray-300');
    }
  };

  document.getElementById('reset').addEventListener('click', () => {
    order = [...puzzle.initialOrder];
    attempts = 0;
    attemptsEl.textContent = attempts;
    solved = false;
    feedbackEl.textContent = 'Blocks reset. Drag again to restart the timer.';
    feedbackEl.classList.remove('text-[#22c55e]');
    feedbackEl.classList.add('text-gray-300');
    stopTimer();
    startTime = null;
    timerEl.textContent = '00:00';
    renderList();
  });

  document.getElementById('check').addEventListener('click', () => {
    checkOrder();
  });

  document.getElementById('run').addEventListener('click', () => {
    const isCorrect = order.every((v, i) => v === puzzle.correctOrder[i]);
    if (isCorrect) {
      outputEl.textContent = `Output: ${puzzle.expectedOutput}`;
    } else {
      outputEl.textContent = 'Output: — (fix the order to reveal)';
    }
  });

  document.getElementById('share').addEventListener('click', async () => {
    const isCorrect = order.every((v, i) => v === puzzle.correctOrder[i]);
    const shareText = isCorrect
      ? `I solved MathCodes ${puzzle.id} in ${timerEl.textContent} with ${attempts} checks! #mathcodes #dailychallenge`
      : `Trying MathCodes ${puzzle.id}. Can you arrange the Python blocks for the sin(x)/x limit? #mathcodes #dailychallenge`;
    if (navigator.share) {
      try {
        await navigator.share({ title: 'MathCodes Daily Challenge', text: shareText, url: window.location.href });
        shareStatusEl.textContent = 'Shared successfully!';
      } catch (err) {
        shareStatusEl.textContent = 'Share cancelled.';
      }
    } else if (navigator.clipboard && navigator.clipboard.writeText) {
      try {
        await navigator.clipboard.writeText(`${shareText} ${window.location.href}`);
        shareStatusEl.textContent = 'Copied share text to clipboard!';
      } catch (err) {
        shareStatusEl.textContent = 'Clipboard access blocked—copy manually.';
      }
    } else {
      shareStatusEl.textContent = 'Sharing not supported in this browser.';
    }
  });

  loadProgress();
  renderList();
</script>

<style>
  .code-card {
    background: #0b1224;
    border: 1px solid #1f2937;
    border-radius: 0.5rem;
    padding: 0.75rem;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    transition: border-color 0.2s ease, transform 0.15s ease, opacity 0.15s ease;
  }
  .code-card.dragging {
    opacity: 0.6;
    transform: scale(0.99);
  }
  .code-card.drag-over {
    border-color: #38bdf8;
  }
  .handle {
    background: #1f2937;
    color: #d1d5db;
    border-radius: 0.375rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: grab;
  }
</style>
