---
import Layout from 'layouts/Layout.astro';

type PuzzleData = {
  id: string;
  date: string;
  topic: string;
  problem: string;
  code_blocks: string[];
  correct_order: number[];
  expected_output: string;
  hints: string[];
};

const puzzleModules = import.meta.glob('../data/daily-challenge-*.json', {
  eager: true,
});

const allPuzzles = Object.values(puzzleModules)
  .map((module) => (module as { default: PuzzleData }).default)
  .sort((a, b) => a.date.localeCompare(b.date));

const todayIso = new Date().toISOString().slice(0, 10);

const typedPuzzle = (() => {
  const exact = allPuzzles.find((entry) => entry.date === todayIso);
  if (exact) return exact;

  const pastPuzzles = allPuzzles.filter((entry) => entry.date < todayIso);
  if (pastPuzzles.length > 0) {
    const randomIndex = Math.floor(Math.random() * pastPuzzles.length);
    return pastPuzzles[randomIndex];
  }

  const randomIndex = Math.floor(Math.random() * allPuzzles.length);
  return allPuzzles[randomIndex];
})();

const blocksWithIds = typedPuzzle.code_blocks.map((block, index) => ({
  id: index + 1,
  text: block,
}));

const displayBlocks = [...blocksWithIds].sort(() => Math.random() - 0.5);

const remappedCorrectOrder = Array.isArray(typedPuzzle.correct_order)
  ? typedPuzzle.correct_order
      .map((value) => Number(value))
      .filter((value) => Number.isFinite(value))
  : [];

const initialOrder = displayBlocks.map((block) => block.id);
const puzzleForClient = {
  id: typedPuzzle.id,
  date: typedPuzzle.date,
  topic: typedPuzzle.topic,
  problem: typedPuzzle.problem,
  codeBlocks: blocksWithIds,
  correctOrder: remappedCorrectOrder,
  expectedOutput: typedPuzzle.expected_output,
  hints: typedPuzzle.hints,
  initialOrder,
};
---

<Layout
  title="Daily Code-Arrange Challenge | MathCodes"
  description="Arrange shuffled Python blocks to solve today's math puzzle. Zero backend compute, just logic and ordering."
>
  <main class="bg-[#0f1625] text-white min-h-screen pb-20">
    <section class="max-w-5xl mx-auto text-center px-6 py-16 space-y-5">
      <p class="text-sm uppercase tracking-[0.2em] text-blue-200">New Flagship Feature</p>
      <h1 class="text-4xl md:text-5xl font-extrabold leading-tight">
        Daily Code-Arrange Challenge (Math Wordle)
      </h1>
      <p class="text-lg text-blue-100 max-w-3xl mx-auto">
        Drag and arrange the shuffled Python blocks to reconstruct a correct solution. When you "run" it, you see the
        pre-stored expected output—no sandboxing, no backend compute. Practice math logic with instant, low-friction feedback.
      </p>
      <div class="flex flex-col md:flex-row gap-3 justify-center">
        <a
          href="/daily-challenge"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-blue-200 text-blue-800 text-lg rounded-xl font-semibold shadow-md"
        >
          <span class="text-xl">🧩</span>
          <span>Try today's puzzle</span>
        </a>
        <a
          href="/system-spec"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-transparent border border-blue-200 text-blue-100 text-lg rounded-xl hover:bg-blue-200 hover:text-blue-800 transition font-semibold"
        >
          <span class="text-xl">📜</span>
          <span>See how it stays zero-backend</span>
        </a>
        <a
          href="/topics"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-[#1b91d6] text-white text-lg rounded-xl font-semibold hover:bg-blue-400"
        >
          <span class="text-xl">🧠</span>
          <span>Browse coding problems</span>
        </a>
      </div>
    </section>

    <section class="max-w-6xl mx-auto grid md:grid-cols-5 gap-6 px-6">
      <div class="md:col-span-2 bg-[#151b2c] border border-[#223455] rounded-2xl p-6 shadow-lg space-y-6">
        <div class="space-y-2">
          <p class="text-sm uppercase tracking-wide text-blue-200">How it works</p>
          <h2 class="text-2xl font-bold">Logic-first, zero backend</h2>
          <p class="text-blue-100 leading-relaxed">
            Each puzzle ships as static JSON. Users drag to reorder blocks, then hit Run to reveal the stored output. There's no
            sandbox or Python execution—perfect for rapid, viral play without infrastructure.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-3">
          <div class="rounded-xl border border-[#2c3f64] bg-[#0e1422] p-4">
            <p class="text-sm text-blue-200 uppercase tracking-wide">Puzzle meta</p>
            <div class="flex flex-col gap-1 text-blue-100">
              <span><strong>ID:</strong> {typedPuzzle.id}</span>
              <span><strong>Date:</strong> {typedPuzzle.date}</span>
              <span><strong>Topic:</strong> {typedPuzzle.topic}</span>
            </div>
          </div>
          <div class="rounded-xl border border-[#2c3f64] bg-[#0e1422] p-4">
            <p class="text-sm text-blue-200 uppercase tracking-wide">Education win</p>
            <ul class="list-disc list-inside text-blue-100 space-y-1 text-left">
              <li>Checks math reasoning, not sandbox tricks.</li>
              <li>Single Astro page—ready for daily updates.</li>
              <li>Mock output reinforces the target result.</li>
            </ul>
          </div>
          <div class="rounded-xl border border-[#2c3f64] bg-[#0e1422] p-4">
            <p class="text-sm text-blue-200 uppercase tracking-wide">Puzzle format (JSON/YAML)</p>
            <pre class="bg-[#0c111d] border border-[#1e2d4a] rounded-lg text-left text-sm text-blue-100 p-3 overflow-x-auto">
              <code>
{`id: ${typedPuzzle.id}
topic: ${typedPuzzle.topic}
problem: ${typedPuzzle.problem}
code_blocks: [...]`}              </code>
            </pre>
          </div>
        </div>
      </div>

      <div class="md:col-span-3 bg-[#111827] border border-[#223455] rounded-2xl p-6 shadow-xl space-y-6">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
          <div>
            <p class="text-sm text-blue-200 uppercase tracking-wide">Daily puzzle</p>
            <h2 class="text-2xl font-bold">{typedPuzzle.problem}</h2>
          </div>
          <div class="flex items-center gap-3 text-sm text-blue-100">
            <span class="px-3 py-1 rounded-full bg-[#1c2740] border border-[#2c3f64]">Expected output: {typedPuzzle.expected_output}</span>
            <span class="px-3 py-1 rounded-full bg-[#1c2740] border border-[#2c3f64]" data-timer>Timer: 00:00</span>
          </div>
        </div>

        <div class="space-y-3">
          <p class="text-blue-100">Drag and drop the blocks until they represent a valid solution. The order shown below is intentionally mixed.</p>
          <ul id="block-list" class="space-y-3" aria-label="code blocks" data-initial-order={initialOrder.join(',')}>
            {displayBlocks.map((block) => (
              <li
                class="bg-[#0e1422] border border-[#2c3f64] rounded-xl p-4 flex items-start gap-3 shadow hover:border-blue-500 transition cursor-move"
                draggable="true"
                data-index={block.id}
              >
                <span class="text-sm text-blue-200 px-2 py-1 rounded-full bg-[#1c2740] border border-[#2c3f64]" aria-hidden="true">Block</span>
                <code class="text-blue-50 text-left whitespace-pre">{block.text}</code>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-wrap gap-3">
          <button
            class="px-5 py-3 bg-blue-200 text-blue-900 rounded-xl font-semibold hover:bg-blue-300 transition"
            type="button"
            data-run
          >
            Run (reveal stored output)
          </button>
          <button
            class="px-5 py-3 bg-transparent border border-blue-200 text-blue-100 rounded-xl font-semibold hover:bg-blue-200 hover:text-blue-900 transition"
            type="button"
            data-reset
          >
            Reset order
          </button>
          <button
            class="px-5 py-3 bg-[#1b91d6] text-white rounded-xl font-semibold hover:bg-blue-400 transition"
            type="button"
            data-hint-toggle
          >
            Show hint
          </button>
        </div>

        <div class="rounded-xl border border-[#2c3f64] bg-[#0c111d] p-4 space-y-3">
          <div class="flex flex-wrap items-center gap-3 text-sm text-blue-100">
            <span class="px-3 py-1 rounded-full bg-[#1c2740] border border-[#2c3f64]" data-attempts>Attempts: 0</span>
            <span class="px-3 py-1 rounded-full bg-[#1c2740] border border-[#2c3f64]">No sandboxing—pure ordering logic</span>
            <span class="px-3 py-1 rounded-full bg-[#1c2740] border border-[#2c3f64]">Mock output only</span>
          </div>
          <p class="text-lg font-semibold text-blue-50" data-status>Arrange the blocks, then tap Run to check.</p>
          <div class="rounded-lg bg-[#0e1628] border border-[#223455] p-3">
            <p class="text-sm uppercase tracking-wide text-blue-200">Displayed output</p>
            <pre
              class="text-blue-50 text-lg"
              data-output
              data-expected-output={typedPuzzle.expected_output}
            >
              —
            </pre>
          </div>
          <div class="rounded-lg bg-[#0e1628] border border-[#223455] p-3 hidden" data-hint-panel>
            <p class="text-sm uppercase tracking-wide text-blue-200">Hint</p>
            <ul class="list-disc list-inside text-blue-100 space-y-1">
              {typedPuzzle.hints.map((hint) => (
                <li>{hint}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script type="application/json" id="puzzle-data">{JSON.stringify(puzzleForClient)}</script>

<script is:inline>
  const puzzleDataEl = document.getElementById('puzzle-data');
  let puzzle = {};

  try {
    puzzle = puzzleDataEl ? JSON.parse(puzzleDataEl.textContent || '{}') : {};
  } catch (error) {
    console.error('Failed to parse puzzle data', error);
  }

  const list = document.getElementById('block-list');
  const runButton = document.querySelector('[data-run]');
  const resetButton = document.querySelector('[data-reset]');
  const statusEl = document.querySelector('[data-status]');
  const outputEl = document.querySelector('[data-output]');
  const attemptsEl = document.querySelector('[data-attempts]');
  const hintButton = document.querySelector('[data-hint-toggle]');
  const hintPanel = document.querySelector('[data-hint-panel]');
  const timerEl = document.querySelector('[data-timer]');

  let attempts = 0;
  let draggedItem = null;
  let timerInterval = null;

  if (!list) {
    console.error('Daily challenge failed to boot: missing list element.');
  }

  const toNumberArray = (value) =>
    Array.isArray(value)
      ? value
          .map((val) => Number(val))
          .filter((val) => Number.isFinite(val))
      : [];

  function getDatasetOrder() {
    const attrOrder = list?.dataset.initialOrder;
    if (!attrOrder) return [];
    return attrOrder
      .split(',')
      .map((value) => Number(value.trim()))
      .filter((val) => Number.isFinite(val));
  }

  function buildNormalizedPuzzle() {
    const blockIds = Array.isArray(puzzle.codeBlocks)
      ? puzzle.codeBlocks
          .map((block) => Number((block && block.id) ?? block))
          .filter((val) => Number.isFinite(val))
      : [];

    const idSet = new Set(blockIds);

    const datasetOrder = getDatasetOrder();
    const parsedInitial = toNumberArray(puzzle.initialOrder);
    const initialOrder = (() => {
      if (parsedInitial.length === blockIds.length && parsedInitial.every((id) => idSet.has(id))) {
        return parsedInitial;
      }
      if (datasetOrder.length === blockIds.length && datasetOrder.every((id) => idSet.has(id))) {
        return datasetOrder;
      }
      return blockIds;
    })();

    const parsedCorrect = toNumberArray(puzzle.correctOrder);
    const normalizedCorrect = [];
    for (const val of parsedCorrect) {
      if (idSet.has(val) && !normalizedCorrect.includes(val)) {
        normalizedCorrect.push(val);
      }
    }

    const hasCompleteOrder =
      normalizedCorrect.length === blockIds.length &&
      normalizedCorrect.length === new Set(normalizedCorrect).size &&
      normalizedCorrect.every((val) => idSet.has(val));

    const expectedOutput =
      typeof puzzle.expectedOutput === 'string' && puzzle.expectedOutput.trim().length
        ? puzzle.expectedOutput
        : outputEl?.dataset.expectedOutput || 'No output available';

    return {
      blockIds,
      correctOrder: hasCompleteOrder ? normalizedCorrect : [],
      expectedOutput,
      initialOrder,
    };
  }

  const normalizedPuzzle = buildNormalizedPuzzle();

  function startTimer() {
    const start = Date.now();
    timerInterval = setInterval(() => {
      const elapsed = Date.now() - start;
      const minutes = Math.floor(elapsed / 60000).toString().padStart(2, '0');
      const seconds = Math.floor((elapsed % 60000) / 1000).toString().padStart(2, '0');
      if (timerEl) {
        timerEl.textContent = `Timer: ${minutes}:${seconds}`;
      }
    }, 1000);
  }

  function stopTimer() {
    if (timerInterval) {
      clearInterval(timerInterval);
      timerInterval = null;
    }
  }

  function getCurrentOrder() {
    if (!list) return [];
    return Array.from(list.children).map((child) => Number(child.dataset.index));
  }

  function applyOrder(order) {
    if (!list) return;
    const items = Array.from(list.children);
    const map = new Map(items.map((item) => [Number(item.dataset.index), item]));
    order.forEach((id) => {
      const node = map.get(id);
      if (node) list.appendChild(node);
    });
  }

  function setStatus(message, isSuccess = false) {
    statusEl.textContent = message;
    statusEl.classList.toggle('text-green-300', isSuccess);
    statusEl.classList.toggle('text-blue-50', !isSuccess);
  }

  function handleRun() {
    if (!normalizedPuzzle.correctOrder.length) {
      setStatus('Puzzle data is missing—please refresh and try again.');
      return;
    }

    if (!puzzle.validIds || puzzle.correctOrder.length !== puzzle.validIds.length) {
      setStatus('Puzzle validation failed—please refresh the page.');
      return;
    }

    attempts += 1;
    attemptsEl.textContent = `Attempts: ${attempts}`;

    const currentOrder = getCurrentOrder();
    const hasAllBlocks =
      currentOrder.length === normalizedPuzzle.blockIds.length &&
      currentOrder.length === new Set(currentOrder).size &&
      currentOrder.every((val) => normalizedPuzzle.blockIds.includes(val));

    if (!hasAllBlocks) {
      setStatus('Some blocks are missing or duplicated—reset and try again.');
      return;
    }

    const isCorrect =
      currentOrder.length === normalizedPuzzle.correctOrder.length &&
      currentOrder.every((val, idx) => val === normalizedPuzzle.correctOrder[idx]);

    outputEl.textContent = normalizedPuzzle.expectedOutput;

    if (isCorrect) {
      setStatus('Nice! The blocks are in the right order.');
      stopTimer();
      list.classList.add('ring-2', 'ring-green-400');
    } else {
      setStatus('Not quite. Tweak the order and try again.');
      list.classList.remove('ring-2', 'ring-green-400');
    }
  }

  function handleReset() {
    applyOrder(normalizedPuzzle.initialOrder);
    attempts = 0;
    attemptsEl.textContent = 'Attempts: 0';
    setStatus('Arrange the blocks, then tap Run to check.');
    outputEl.textContent = '—';
    list.classList.remove('ring-2', 'ring-green-400');
    stopTimer();
    startTimer();
  }

  function wireDragAndDrop() {
    if (!list) return;

    list.addEventListener('dragstart', (event) => {
      draggedItem = event.target.closest('li');
      if (!draggedItem) return;
      draggedItem.classList.add('opacity-60', 'border-blue-400');
      if (event.dataTransfer) {
        event.dataTransfer.effectAllowed = 'move';
        event.dataTransfer.setData('text/plain', draggedItem.dataset.index || '');
      }
    });

    list.addEventListener('dragend', () => {
      if (!draggedItem) return;
      draggedItem.classList.remove('opacity-60', 'border-blue-400');
      draggedItem = null;
    });

    list.addEventListener('dragover', (event) => {
      event.preventDefault();
      const target = event.target.closest('li');
      if (!draggedItem || !target || draggedItem === target) return;
      const bounding = target.getBoundingClientRect();
      const offset = bounding.y + bounding.height / 2;
      if (event.clientY - offset > 0) {
        target.after(draggedItem);
      } else {
        target.before(draggedItem);
      }
    });

    list.addEventListener('drop', (event) => {
      event.preventDefault();
    });
  }

  runButton?.addEventListener('click', handleRun);
  resetButton?.addEventListener('click', handleReset);
  hintButton?.addEventListener('click', () => {
    hintPanel?.classList.toggle('hidden');
    hintButton.textContent = hintPanel?.classList.contains('hidden') ? 'Show hint' : 'Hide hint';
  });

  wireDragAndDrop();
  applyOrder(normalizedPuzzle.initialOrder);
  startTimer();
</script>

<style>
  code {
    font-family: 'Fira Code', 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
  }
</style>
